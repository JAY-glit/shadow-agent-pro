# Copy this file to .env (same folder) and fill in your own values.
# .env is already in .gitignore — never commit real keys.
#
# Everything below is OPTIONAL. The app runs fully without any of it —
# threat_intel.py checks for these at request time and simply skips that
# signal (returns {"available": False}) if the key is missing. Nothing
# breaks; you just lose the VirusTotal/Safe Browsing cross-check layer
# until you add a key.

# --- Flask secret (used to sign JWTs) ---
# Any random string works for local dev. Generate one properly for anything
# beyond your own machine: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-something-random

# --- VirusTotal (free tier: ~4 requests/min, 500/day) ---
# 1. Sign up at https://www.virustotal.com/gui/join-us
# 2. Click your profile icon (top right) -> "API key"
# 3. Paste it below
VIRUSTOTAL_API_KEY=

# --- Google Safe Browsing (free, generous quota) ---
# 1. Go to https://console.cloud.google.com/ and create a project (free)
# 2. APIs & Services -> Library -> search "Safe Browsing API" -> Enable
# 3. APIs & Services -> Credentials -> Create Credentials -> API key
# 4. (Recommended) restrict the key to the Safe Browsing API only
SAFE_BROWSING_API_KEY=

# --- Redis (only needed if not using the default 127.0.0.1:6379) ---
REDIS_URL=redis://127.0.0.1:6379/0